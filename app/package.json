{
  "name": "galim-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:scenes": "tsc --noEmit && VITE_DEV_SCENES=1 vite build",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Jerusalem vitest run",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@fontsource/assistant": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  }
